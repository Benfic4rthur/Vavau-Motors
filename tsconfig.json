{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "app",
    "vite.static.config.ts",
    "api"
  ],
  "exclude": [
    "node_modules"
  ]
}
