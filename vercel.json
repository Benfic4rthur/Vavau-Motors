{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist-static",
  "installCommand": "npm ci --no-audit --no-fund",
  "functions": { "api/admin.ts": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/admin", "destination": "/admin.html" }],
  "headers": [
    {"source":"/admin", "headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/admin.html", "headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/(.*)", "headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}
  ]
}
